{
  "headings": {
    "h1": {
      "font-weight": "extra-bold",
      "line-height": 0.95,
      "letter-spacing": "-1%",
      "text-transform": "uppercase"
    },
    "h2": {
      "font-weight": "extra-bold",
      "line-height": 0.95,
      "letter-spacing": "1%"
    },
    "h3": {
      "font-weight": "bold",
      "line-height": 0.95,
      "letter-spacing": "-1%"
    },
    "h4": {
      "font-weight": "semi-bold",
      "line-height": 1,
      "letter-spacing": "0%"
    },
    "h5": {
      "font-weight": "semi-bold",
      "line-height": 1.2,
      "letter-spacing": "0%"
    },
    "h6": {
      "font-weight": "medium",
      "line-height": 1.3,
      "letter-spacing": "0%"
    }
  },
  "paragraph": {
    "font-weight": "normal",
    "line-height": 1.3,
    "letter-spacing": "0%"
  }
}